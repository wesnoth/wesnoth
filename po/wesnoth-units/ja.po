#. [variation]
#: data/core/units/undead/Corpse_Soulless.cfg:385
#: data/core/units/undead/Corpse_Walking.cfg:384
msgid "wc_variation^Spider"
msgstr "クモ"

#. [variation]
#: data/core/units/undead/Corpse_Soulless.cfg:394
#: data/core/units/undead/Corpse_Walking.cfg:393
msgid "wc_variation^Serpent"
msgstr "サーペント"

#. [variation]
#: data/core/units/undead/Corpse_Soulless.cfg:413
#: data/core/units/undead/Corpse_Walking.cfg:412
msgid "wc_variation^Swimmer"
msgstr "水棲生物"

#. [variation]
#: data/core/units/undead/Corpse_Soulless.cfg:431
#: data/core/units/undead/Corpse_Walking.cfg:430
msgid "wc_variation^Troll"
msgstr "トロル"

#. [variation]
#: data/core/units/undead/Corpse_Soulless.cfg:440
#: data/core/units/undead/Corpse_Walking.cfg:439
