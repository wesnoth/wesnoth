#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:178
msgid "Addroran’s Gaze"
msgstr "Addroran’ın Bakışı"

#. [side]
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:151
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:186
msgid "Mace of Eldaric"
msgstr "Eldarik’in Topuzu"

#. [side]
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:182
msgid "Stormvale"
msgstr "Fırtınavadi"

#. [side]
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:187
msgid "Southbay"
msgstr "Güney Körfezi"

#. [side]
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:200
msgid "Hatchlings"
msgstr "Yavrular"

#. [event]
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:247
msgid "Oxepotex"
msgstr "Oksepoteks"

#. [message]: speaker=Oxepotex
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:255
msgid "I am Oxepotex! Massster tamer of beassstsss big and sssmall."
msgstr "Ben Oksepoteks! Büyük küçük hayvanların usssta terbiyecisi."

#. [message]: speaker=Arinexis
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:260
msgid ""
"Sssettle down, Oxe.\n"
"\n"
"And get to work feeding your petsss!"
msgstr ""
"Sakin ol, Okse.\n"
"\n"
"Ve işine dön, evcil hayvanlarını besle!"

#. [message]: speaker=unit
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:288
msgid "I hear..."
msgstr "Duyuyorum..."

#. [event]
