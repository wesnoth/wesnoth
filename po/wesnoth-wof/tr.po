msgstr "Bu safir taşıyıcısına menzilli bir soğuk saldırı kazandırır!"

#. [effect]: type=cold
#: data/campaigns/Winds_of_Fate/utils/macros.cfg:223
msgid "sapphire of ice"
msgstr "buz safiri"
