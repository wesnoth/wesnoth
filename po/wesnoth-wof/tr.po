#. [message]: speaker=narrator
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:346
msgid ""
"Achievement Unlocked:\n"
"\n"
"<b>Leader of Mice</b>"
msgstr ""
"Başarım Açıldı:\n"
"\n"
"<b>Farelerin Lideri</b>"

#. [objective]: condition=win
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:408
msgid "Kill Rhynnin"
msgstr "Rinnin’i öldür"

#. [objective]: condition=win
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:417
msgid "Capture all villages"
msgstr "Bütün köyleri ele geçir"

#. [objective]: condition=lose
#: data/campaigns/Winds_of_Fate/scenarios/05_Threshold.cfg:429
#: data/campaigns/Winds_of_Fate/scenarios/06_Landfall.cfg:129
#: data/campaigns/Winds_of_Fate/scenarios/07_Harvest.cfg:251
#: data/campaigns/Winds_of_Fate/scenarios/08_Overlook.cfg:224
#: data/campaigns/Winds_of_Fate/scenarios/09_Ancestor.cfg:93
#: data/campaigns/Winds_of_Fate/scenarios/09_Ancestor.cfg:375
#: data/campaigns/Winds_of_Fate/scenarios/10_Fire_Meets_Steel.cfg:296
