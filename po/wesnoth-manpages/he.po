#. type: TP
#: doc/man/wesnothd.6:248
#, no-wrap
msgid "B<db_user>"
msgstr "B<db_user>"

#. type: Plain text
#: doc/man/wesnothd.6:251
msgid "The name of the user under which to log into the database"
msgstr "שם המשתמש שדרכו מתחברים למסד הנתונים"

# type: TP
#. type: TP
#: doc/man/wesnothd.6:251
#, no-wrap
msgid "B<db_password>"
msgstr "B<db_password>"

#. type: Plain text
#: doc/man/wesnothd.6:254
msgid "This user's password"
msgstr "הסיסמה של משתמש זה"

# type: TP
#. type: TP
#: doc/man/wesnothd.6:254
#, no-wrap
msgid "B<db_users_table>"
msgstr "B<db_users_table>"

#. type: Plain text
#: doc/man/wesnothd.6:257
msgid ""
"The name of the table in which your phpbb forum saves its user data. Most "
"likely this will be E<lt>table-prefixE<gt>_users (e.g. phpbb3_users)."
msgstr ""
"שם הטבלה שבה פורום ה-phpbb שלכם שומר את נתוני המשתמשים שלו. סביר להניח שיהיה "
"זה E<lt>table-prefixE<gt>_users (למשל phpbb3_users)."

# type: TP
#. type: TP
#: doc/man/wesnothd.6:257
#, no-wrap
msgid "B<db_extra_table>"
msgstr "B<db_extra_table>"

#. type: Plain text
#: doc/man/wesnothd.6:260
msgid ""
"The name of the table in which wesnothd will save its own data about users."
msgstr "שם הטבלה שבה wesnothd ישמור את הנתונים שלו על משתמשים."

#. type: TP
#: doc/man/wesnothd.6:260
#, no-wrap
msgid "B<db_game_info_table>"
msgstr "B<db_game_info_table>"

#. type: Plain text
#: doc/man/wesnothd.6:263
msgid ""
"The name of the table in which wesnothd will save its own data about games."
msgstr "שם הטבלה שבה wesnothd ישמור את הנתונים שלו על משחקים."

#. type: TP
#: doc/man/wesnothd.6:263
#, no-wrap
