#: doc/man/wesnothd.6:308
msgid "B<wesnoth>(6)"
msgstr "B<wesnoth>(6)"

#, no-wrap
#~ msgid "B<--addon-info>"
#~ msgstr "B<--addon-info>"

#~ msgid ""
#~ "Shows a button on the add-ons manager to query the add-ons server for "
#~ "various information."
#~ msgstr ""
#~ "מציג כפתור במנהל התוספים לשליחת שאילתה לשרת התוספים לקבלת מידע מגוון."

#~ msgid ""
#~ "Overrides the data directory with the one specified. The data directory "
#~ "is the one that contains subdirectories 'data', 'fonts', 'images' and "
#~ "others."
#~ msgstr ""
#~ "עוקף את תיקיית הנתונים בתיקייה שצוינה. תיקיית הנתונים היא זו שמכילה את תת-"
#~ "התיקיות 'data', 'fonts', 'images' ואחרות."

#~ msgid ""
#~ "sets the severity level of the log domains. The wildcard B<*> may be used "
#~ "to match a subset of domains, e.g. gui/* or conf* or * (the latter "
#~ "matches all domains).  Available levels: B<error>,\\ B<warning>,\\ "
#~ "B<info>,\\ B<debug>,\\ B<none>.  By default, the B<warning> level is used "
#~ "for most domains, but B<deprecation> defaults to B<none> unless combined "
#~ "with the B<-d> option.  This option can be specified multiple times."
#~ msgstr ""
#~ "קובע את רמת החומרה של תחומי היומן (log domains). ניתן להשתמש בתו הכללי "
#~ "B<*> כדי להתאים קבוצת משנה של תחומים, למשל gui/* או conf* או * (האחרון "
#~ "תואם לכל התחומים). רמות זמינות: B<error>,\\ B<warning>,\\ B<info>,\\ "
#~ "B<debug>,\\ B<none>. כברירת מחדל, רמת B<warning> משמשת עבור רוב התחומים, "
#~ "אך B<deprecation> ברירת המחדל שלה היא B<none> אלא אם משולבת עם האפשרות B<-"
#~ "d>. ניתן לציין אפשרות זו מספר פעמים."

#, no-wrap
#~ msgid "B<--no-log-sanitize>"
#~ msgstr "B<--no-log-sanitize>"

#~ msgid ""
#~ "disables the anonymization that's normally applied when logging, for "
#~ "example replacing usernames with USER."
#~ msgstr ""
#~ "מבטל את האנונימיזציה שמופעלת בדרך כלל בעת רישום ליומן, למשל החלפת שמות "
#~ "משתמשים ב-USER."

#, no-wrap
#~ msgid "B<--preprocess-string>I<\\ source-string>"
#~ msgstr "B<--preprocess-string>I<\\ source-string>"

#~ msgid "preprocesses a given string and writes the output to stdout."
#~ msgstr "מבצע עיבוד מקדים למחרוזת נתונה וכותב את הפלט ל-stdout."

#~ msgid ""
#~ "The name of the table in which wesnothd will save its own data about game "
#~ "content (scenario/era/modifications) used in a game."
#~ msgstr ""
#~ "שם הטבלה שבה wesnothd ישמור את הנתונים שלו על תוכן המשחק "
#~ "(תרחיש/עידן/שינויים) שבו נעשה שימוש במשחק."

#, no-wrap
#~ msgid "B<db_tournament_query>"
#~ msgstr "B<db_tournament_query>"

#~ msgid ""
#~ "The SQL query to find tournaments to announce on login. Should return "
#~ "tournament B<title>, B<status> and B<url>."
#~ msgstr ""
#~ "שאילתת ה-SQL למציאת טורנירים להכרזה בעת כניסה. צריכה להחזיר B<title>, "
#~ "B<status> ו-B<url> של הטורניר."

#, no-wrap
#~ msgid "B<forum_admin_group>"
#~ msgstr "B<forum_admin_group>"

#~ msgid ""
#~ "The ID of one of the forum groups to be considered as having admin "
#~ "authority on the add-ons server."
#~ msgstr ""
#~ "מזהה אחת מקבוצות הפורום שתיחשב כבעלת סמכות ניהול (admin) בשרת התוספים."

#, no-wrap
#~ msgid "B<site_admin_group>"
#~ msgstr "B<site_admin_group>"
