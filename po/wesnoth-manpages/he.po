# type: TP
#. type: TP
#: doc/man/wesnothd.6:245
#, no-wrap
msgid "B<db_name>"
msgstr "B<db_name>"

#. type: Plain text
#: doc/man/wesnothd.6:248
msgid "The name of the database"
msgstr "שם מסד הנתונים"

