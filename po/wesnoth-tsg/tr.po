#~ "was not innocent either."
#~ msgstr ""
#~ "İnsan doğruyu söylüyor. Kalbim Mebrin için çok üzülse de, masum değildi."

#~ msgid "Fine words for a traitor."
#~ msgstr "Bir hain için güzel sözler."

