#~ "ולקוות שהאלפים ישובו לשפיות."

#~ msgid "For Weldyn! For Westin! For our home!!"
#~ msgstr "למען וולדין! למען ווסטין! למען ביתנו!!"

#~ msgid ""
#~ "The elves are trying to break into the cellars! Remember our objectives — "
#~ "if they get among the refugees, all will be lost."
#~ msgstr ""
#~ "האלפים מנסים לפרוץ אל המרתפים! זכרו את יעדינו — אם יגיעו אל הפליטים, הכול "
