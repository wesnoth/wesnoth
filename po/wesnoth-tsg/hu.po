#~ msgid "My brother has died unavenged! I have failed!"
#~ msgstr "A testvérem halálát nem bosszultuk meg! Kudarcot vallottam!"

#~ msgid "The bandits are scattering! We have saved Westin!"
#~ msgstr "Szétszóródnak a banditák! Megmentettük Westint!"

