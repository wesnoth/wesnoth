#~| msgid "(Beginner)"
#~ msgid "Beginner"
#~ msgstr "(Αρχάριος)"

#~ msgid "Fighter"
#~ msgstr "Πολεμιστής"

#~ msgid "Lord"
#~ msgstr "Άρχοντας"

