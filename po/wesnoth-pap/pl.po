msgstr ""
"W scenariuszu <i>Pływając z wężami</i> pokonaj przywódcę wroga, zanim dotrą "
"twoi sojusznicy."

#. [achievement_group]
#: data/campaigns/Of_Pearls_and_Pirates/achievements.cfg:27
msgid "Scenario 2: The Best Defense..."
msgstr "Scenariusz 2: Najlepszą obroną jest..."

#. [achievement_group]
#: data/campaigns/Of_Pearls_and_Pirates/achievements.cfg:28
msgid "Defeat the enemy leader in <i>Desolation</i>."
msgstr "W scenariuszu <i>Spustoszenie</i> pokonaj przywódcę wroga."

#. [achievement_group]
#: data/campaigns/Of_Pearls_and_Pirates/achievements.cfg:28
msgid "Scenario 3: Little Red Riding Hood"
msgstr "Scenariusz 3: Czerwony Kapturek"

#. [achievement_group]
#: data/campaigns/Of_Pearls_and_Pirates/achievements.cfg:29
msgid "Complete <i>Lee Shore</i> without freeing any slaves."
msgstr "Ukończ <i>Zawietrzny brzeg</i>, nie uwalniając żadnych niewolników."

#. [achievement_group]
#: data/campaigns/Of_Pearls_and_Pirates/achievements.cfg:29
