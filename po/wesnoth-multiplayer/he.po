msgstr "פסלו של טן-זין"

#. [unit]
#: data/multiplayer/scenarios/2p_Sullas_Ruins.cfg:110
msgid "A stone-carved likeness of Ten-zin, Servant of Sulla."
msgstr "דמות מגולפת באבן של טן-זין, משרתה של סולה."

#. [side]
#: data/multiplayer/scenarios/2p_Sullas_Ruins.cfg:112
msgid "Statue of Lo-bsang"
msgstr "פסלו של לו-בסאנג"

