msgstr "דמות מגולפת באבן של לון-דופ, משרתה של סולה."

#. [side]
#: data/multiplayer/scenarios/2p_Sullas_Ruins.cfg:104
msgid "Statue of Ri-nzen"
msgstr "פסלו של רי-נזן"

#. [unit]
#: data/multiplayer/scenarios/2p_Sullas_Ruins.cfg:106
msgid "A stone-carved likeness of Ri-nzen, Servant of Sulla."
msgstr "דמות מגולפת באבן של רי-נזן, משרתה של סולה."

#. [side]
#: data/multiplayer/scenarios/2p_Sullas_Ruins.cfg:108
