#. [multiplayer_side]: id=Custom
#: data/_main.cfg:22
msgid "Custom"
msgstr "По избору"

#. [advanced_preference]: type=combo
#: data/advanced_preferences.cfg:4
msgid "Compress saved games"
msgstr "Сажимање сачуваних игара"

#. [option]: id=gzip
#: data/advanced_preferences.cfg:9
msgid "save_compression^Gzip"
msgstr "Gzip"

#. [option]: id=gzip
#: data/advanced_preferences.cfg:10
msgid "save_compression_desc^Default compression, faster"
msgstr "Подразумевано сажимање, брже"

#. [option]: id=bzip2
#: data/advanced_preferences.cfg:14
msgid "save_compression^Bzip2"
msgstr "Bzip2"

#. [option]: id=bzip2
#: data/advanced_preferences.cfg:15
msgid "save_compression_desc^Best compression, slower"
msgstr "Најбоље сажимање, спорије"

#. [option]: id=none
#: data/advanced_preferences.cfg:19
msgid "save_compression^No"
msgstr "Без сажимања"

#. [option]: id=none
#: data/advanced_preferences.cfg:20
msgid "save_compression_desc^Large plain text files"
msgstr "Велике текстуалне датотеке"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:26
msgid "Show icons in the Add-ons manager"
msgstr "Прикажи иконе у управљању додацима"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:27
msgid ""
"Disabling saves bandwidth by not sending icons for the add-ons list in the "
"add-ons manager"
msgstr ""
"Када је искључено, иконе на списку додатака се не преузимају, па се штеди "
"проток"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:34
msgid "Confirm deleting saves"
msgstr "Потврди брисање сачуваних игара"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:41
msgid "Mouse scrolling"
msgstr "Померање мишем"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:48
msgid "Middle-click scrolling"
msgstr "Померање средњим дугметом миша"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:55
msgid "Keep scrolling when mouse leaves window"
msgstr "Настави померање када миш изађе из прозора"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:62
msgid "Show combat"
msgstr "Прикажи борбу"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:69
msgid "Auto-open whisper windows in lobby"
msgstr "Аутоматски отварај прозоре за шапат у чекаоници"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:76
msgid "Follow unit actions"
msgstr "Прати радње јединица"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:77
msgid ""
"Choose whether the map view should scroll to a unit when an action or move "
"is animated"
msgstr ""
"Када је укључено, приказ мапе прати јединицу док се приказује њено кретање "
"или радња"

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:84
msgid "Chat message aging"
msgstr "Трајање порука ћаскања"

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:85
msgid ""
"Number of minutes to wait before clearing an ingame chat message. Set to 0 "
"to disable."
msgstr "После колико минута се порука у ћаскању брише. Нула искључује брисање."

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:95
msgid "Use 12-hour clock format"
msgstr "Користи 12-часовни запис времена"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:102
msgid "Confirm loading saves from a different version"
msgstr "Потврди учитавање игара сачуваних у другој верзији"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:109
msgid "Show all unit types in help"
msgstr "Прикажи све врсте јединица у помоћи"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:110
msgid ""
"Show all unit types in the help (requires restart). If unset, only units "
"that have been encountered will be shown."
msgstr ""
"Прикажи све врсте јединица у помоћи (потребно поновно покретање игре). Ако "
"се искључи, приказују се само јединице које су раније сусретнуте."

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:117
msgid "Editor recent files limit"
msgstr "Ограничење скорашњих датотека у уређивачу"

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:118
msgid ""
"The maximum number of items to display on the Recent Files menu in the editor"
msgstr "Највише ставки у менију скорашњих датотека у уређивачу"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:128
msgid "Show color cursors"
msgstr "Прикажи стрелице миша у боји"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:129
msgid "Use colored mouse cursors"
msgstr "Користи обојене стрелице миша"

#. [advanced_preference]: type=custom
#: data/advanced_preferences.cfg:136
msgid "Logging"
msgstr "Дневник"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:142
msgid "Allow damage calculation with Monte Carlo simulation"
msgstr "Омогући прорачун штете симулацијом Монте Карло"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:143
msgid ""
"Allow the damage calculation window to simulate fights instead of using "
"exact probability calculations"
msgstr ""
"Омогући да прозор за прорачун штете симулира борбе уместо тачног прорачуна "
"вероватноће"

#. #-#-#-#-#  wesnoth.wml.pot (PACKAGE VERSION)  #-#-#-#-#
#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:150 src/units/abilities.cpp:200
msgid "Show deprecation messages in-game"
msgstr "Прикажи у игри поруке о застарелим функцијама"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:151
msgid ""
"Show warnings about deprecated API in the in-game chat area. These messages "
"will still be shown in the log, even if this is disabled. In addition, the "
"deprecation log-domain controls how many messages are printed."
msgstr ""
"Прикажи упозорења о застарелом API-ју у делу за ћаскање у игри. Те поруке се "
"свакако бележе у дневник, чак и када је ово искључено. Колико порука ће се "
"исписати одређује дневнички домен ‚deprecation‘."

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:158
msgid "Font size scale (experimental)"
msgstr "Величина слова (пробно)"

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:159
msgid ""
"Scales all text up or down from the standard size for your resolution. "
"Warning: Scaling text up may cause issues in the in-game sidebar."
msgstr ""
"Увећава или умањује сав текст у односу на стандардну величину за твоју "
"резолуцију. Упозорење: увећани текст може да направи проблеме у бочној траци "
"у игри."

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:169
msgid "Server disconnect timeout"
msgstr "Време до прекида везе са сервером"

#. [advanced_preference]: type=int
#: data/advanced_preferences.cfg:170
msgid ""
"The amount of time in seconds before a disconnect is detected. If currently "
"logged into the multiplayer server, you must log out and then log back in "
"for this to take effect."
msgstr ""
"После колико секунди се сматра да је веза прекинута. Ако си тренутно на "
"серверу за игру више играча, мораш да се одјавиш и поново пријавиш да би "
"промена важила."

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:180
msgid "Show missed attack indicator"
msgstr "Прикажи ознаку промашаја"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:181
msgid "Display a visual indicator above a defender when an attack misses."
msgstr "Прикажи ознаку изнад браниоца када напад промаши."

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:188
msgid "SIMD acceleration"
msgstr "SIMD убрзање"

#. [advanced_preference]: type=boolean
#: data/advanced_preferences.cfg:189
msgid ""
"Use hardware acceleration (SSE2/NEON) for faster image processing on the "
"CPU. Try disabling this if you experience graphical glitches or crashes."
msgstr ""
"Користи хардверско убрзање (SSE2/NEON) за бржу обраду слика на процесору. "
"Искључи ово подешавање ако примећујеш грешке у приказу или игра „пуца“."

