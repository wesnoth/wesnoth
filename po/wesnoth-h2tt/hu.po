msgstr ""

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:49
msgid "Rest in Pieces"
msgstr "Nyugodjék darabokban"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:50
msgid "(Temporarily) liberate <i>The Dwarven Doors</i>."
msgstr "(Ideiglenesen) szabadítsd fel <i>Törpkaput</i>."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:50
msgid "Hold Fast Your Hope"
msgstr "Ragaszkodj a reménybe"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:51
msgid "Cavefish"
msgstr "Barlangi hal"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:51
msgid ""
"Complete <i>The Lost General</i> while only recruiting or recalling Merfolk."
msgstr ""
"Teljesítsd <i>Az elveszett tábornok</i> küldetést úgy, hogy csak sellőket "
