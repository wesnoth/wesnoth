msgstr "Nagy Delfador"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:26
msgid ""
"Personally defeat 10 enemies with Delfador during '<i>The Elves Besieged</"
"i>'."
msgstr ""
"Győzz le Delfadorral 10 ellenséget a <i>Tündék ostrom alatt</i> küldetés "
"alatt."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:27
msgid "Complete <i>Flight of the Elves</i> with no elf deaths."
msgstr ""
"Teljesítsd <i>A tündék menekülése</i> küldetést tünde veszteség nélkül."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:27
msgid "Elf-friend"
msgstr "Tündebarát"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:28
msgid "Calling in the Cavalry"
msgstr "Lovassági behívó"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:28
msgid "Defeat all enemy leaders during <i>Blackwater Port</i>."
msgstr ""
"Legyőzöl minden ellenséges vezért a <i>Feketevíz kikötő</i> küldetés során."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:29
msgid "Persuade an Arch Mage to join your army in <i>Isle of Alduin</i>."
msgstr ""
"Vegyél rá egy varázslómestert, hogy csatlakozzon hozzád az <i>Alduin "
"szigete</i> küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:29
msgid "Turncoat"
msgstr "Köpönyegforgató"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:30
msgid "A Friend in Need..."
msgstr "Barát a bajban..."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:30
msgid "Complete <i>Muff Malal’s Peninsula</i> before freeing Moremirmu."
msgstr ""
"Teljesíted a <i>Muff Malal félszigete</i> küldetést, mielőtt Moremirmut "
"kiszabadítanád."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:31
msgid "Kill an enemy with Delurin during <i>Isle of the Damned</i>."
msgstr ""
"Ölj meg egy ellenséget Delurinnal az <i>Elátkozottak szigete</i> küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:31
msgid "Town Guard"
msgstr "Várvédő"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:32
msgid "Exterminator"
msgstr "Megsemmisítő"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:32
msgid "Kill all giant spiders during <i>Isle of the Damned II</i>."
msgstr ""
"Öld meg az összes óriáspókot az <i>Elátkozottak szigete II</i> küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:34
msgid "Complete <i>The Siege of Elensefar</i> on Deadly difficulty."
msgstr "Teljesítsd <i>Elensefar ostromát</i> halálos nehézségi fokozaton."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:34
msgid "Probably Impossible"
msgstr "Valószínűleg lehetetlen"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:35
msgid "Complete <i>The Silver City</i> without capturing any villages."
msgstr ""

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:35
msgid "Laissez-faire"
msgstr "Nem beavatkozó"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:38
msgid "Counter-Sniper"
msgstr "Mesterlövész-elhárító"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:38
msgid ""
"Defeat the Master Bowman in <i>Fort Tahn</i> without attacking him with "
"melee weapons."
msgstr ""
"Anélkül győzöd le a mesteríjászt a <i>Fort Than</i> küldetésben, hogy "
"közelharci támadást alkalmaznál."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:39
msgid "Conservationist"
msgstr "Természetvédő"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:39
msgid ""
"Defeat the Mother Gryphon in <i>Gryphon Mountain</i> without killing any "
"other gryphons."
msgstr ""
"Anélkül győzöd le az anyagriffet a <i>Griff-hegység</i> küldetésben, hogy a "
"többi griffet megölnéd."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:40
msgid "Complete part 1 of <i>Valley of Death</i> AFTER completing part 2."
msgstr ""
"A <i>Halál völgye</i> küldetésben előbb a második részt teljesíted, utána az "
"elsőt."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:40
msgid "Quest Unrequested"
msgstr "Kéretlen küldetés"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:41
msgid "Defeat both liches before turns run out in <i>Valley of Death II</i>."
msgstr ""
"Legyőzöd mindkét delevényt a körök vége előtt a <i>Halál völgye II</i> "
"küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:41
msgid "The Best Defense..."
msgstr "A legjobb védekezés..."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:42
msgid "Best Served Hot"
msgstr "Van, aki forrón szereti"

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:42
msgid "Get the finishing blow on Li’sar with Ulfdain during <i>Crossroads</i>."
msgstr ""
"A végső csapást Uldainnal viszed be Li’saron a <i>Keresztutak</i> "
"küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:43
msgid "Defeat all caravans by turn 20 in <i>The Highwaymen</i>."
msgstr ""
"Semmisítsd meg az összes karavánt a 20. körig az <i>Útonállók</i> "
"küldetésben."

#. [achievement_group]
#: data/campaigns/Heir_To_The_Throne/achievements.cfg:43
