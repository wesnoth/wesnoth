#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:670
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:47
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:63
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:83
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:102
#: data/campaigns/Heir_To_The_Throne/scenarios/02_Flight_of_the_Elves.cfg:118
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:44
#: data/campaigns/Heir_To_The_Throne/scenarios/03_Blackwater_Port.cfg:66
