msgstr "组建你的军队（剩余 1 场战斗）"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/00_The_Great_Continent.cfg:524
msgid "Reunite with Delfador"
msgstr "与德法多重新会合"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/00_The_Great_Continent.cfg:533
msgid "Find Delfador"
msgstr "找到德法多"

#. [objective]: condition=win
#: data/campaigns/Heir_To_The_Throne/scenarios/00_The_Great_Continent.cfg:542
