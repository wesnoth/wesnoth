#. [event]: id=konrad_silver_crown_object
#. [scenario]: id=08b_Isle_of_the_Damned_part2
#: data/campaigns/Heir_To_The_Throne/scenarios/01_The_Elves_Besieged.cfg:889
#: data/campaigns/Heir_To_The_Throne/scenarios/08b_Isle_of_the_Damned_part2.cfg:112
#: data/campaigns/Heir_To_The_Throne/scenarios/08b_Isle_of_the_Damned_part2.cfg:118
