#. [message]: speaker=Dverag-Kukai
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:465
msgid "Are all the fishmen in cages yet?"
msgstr "Bütün balık adamlar kafeslerde mi?"

#. [message]: speaker=Managa'Gwin
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:469
msgid "Almost."
msgstr "Neredeyse."

#. [message]: speaker=Managa'Gwin
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:471
msgid ""
"UP, SEA LICE! Drag your slimy hides from the deep! Drop the pearls, then "
"scuttle back to your cages!"
msgstr ""
"KALKIN, DENİZ BİTLERİ! Yapış yapış derilerinizi derinlerden sürükleyin! "
"İncileri bırakın, sonra kafeslerinize geri koşun!"

#. [floating_text]
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:491
msgid "+120 gold"
msgstr "+120 altın"

#. [floating_text]
#: data/campaigns/Heir_To_The_Throne/scenarios/04_The_Bay_of_Pearls.cfg:491
