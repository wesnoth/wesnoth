msgstr "דיווח על כל המאקרואים עם פרמטרים ללא-טיפוס"

#: data/tools/GUI.pyw:937
msgid "Show progress"
msgstr "הצגת התקדמות"

#: data/tools/GUI.pyw:957 data/tools/GUI.pyw:1169
