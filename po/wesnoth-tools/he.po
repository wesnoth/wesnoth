#. files'.
#: data/tools/GUI.pyw:995
msgid "Report only on macros referenced in exactly n files:"
msgstr "דיווח רק על מאקרואים שאליהם מפנים בדיוק n קבצים:"

#: data/tools/GUI.pyw:1015
msgid "Report macro definitions and usages in file:"
msgstr "דיווח על הגדרות ושימושים במאקרואים בקובץ:"

#: data/tools/GUI.pyw:1033
msgid "Allow unused macros with names matching regular expression:"
msgstr "אפשרו מאקרואים לא בשימוש ששמם תואם לביטוי רגולרי:"

