msgstr "אפשרויות wmlscope"

#: data/tools/GUI.pyw:874
msgid "Check for duplicate macro definitions"
msgstr "בדיקת הגדרות מאקרו כפולות"

#: data/tools/GUI.pyw:883
msgid "Check for duplicate resource files"
msgstr "בדיקת קובצי משאבים כפולים"

