msgstr "ציון שם הקובץ לפני העיבוד"

#. TRANSLATORS: Verbosity level.
#: data/tools/GUI.pyw:780
msgid "Show parse details"
msgstr "הצגת פרטי ניתוח (parse)"

#: data/tools/GUI.pyw:789
msgid "wmllint options"
msgstr "אפשרויות wmllint"

#. TRANSLATORS: EOL = Special characters marking 'end-of-line'.
#: data/tools/GUI.pyw:797
msgid "Convert EOL characters to Unix format"
msgstr "המרת תווי סוף-שורה (EOL) לפורמט Unix"

#. TRANSLATORS: 'side=' in this context refers to WML and should not be
#. translated.
#: data/tools/GUI.pyw:808
msgid "Warn about tags without side= keys"
msgstr "אזהרה על תגיות ללא מפתחות side="

#: data/tools/GUI.pyw:817
msgid "Disable checks for unknown units"
msgstr "ביטול בדיקות עבור יחידות לא ידועות"

#: data/tools/GUI.pyw:826
msgid "Disable spellchecking"
msgstr "ביטול בדיקת איות"

