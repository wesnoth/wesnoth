msgid "Clear"
msgstr "ניקוי"

#: data/tools/GUI.pyw:674
msgid "wmllint mode"
msgstr "מצב wmllint"

#. TRANSLATORS: Normal run mode for the WML tool.
#: data/tools/GUI.pyw:681 data/tools/GUI.pyw:1101
msgid "Normal"
msgstr "רגיל"

#. TRANSLATORS: Tooltip explanation for normal run mode.
#: data/tools/GUI.pyw:690 data/tools/GUI.pyw:1110
msgid "Perform conversion and save changes to file"
msgstr "ביצוע ההמרה ושמירת השינויים לקובץ"

#: data/tools/GUI.pyw:693 data/tools/GUI.pyw:1113
msgid "Dry run"
msgstr "הרצה יבשה"

#. TRANSLATORS: Tooltip explanation for dry run mode.
#: data/tools/GUI.pyw:702 data/tools/GUI.pyw:1122
msgid "Perform conversion without saving changes to file"
msgstr "ביצוע ההמרה בלי לשמור את השינויים לקובץ"

#: data/tools/GUI.pyw:705
msgid "Clean"
msgstr "ניקוי"

#. TRANSLATORS: Tooltip explanation for clean mode.
#: data/tools/GUI.pyw:714
msgid "Delete back-up files"
msgstr "מחיקת קבצי גיבוי"

#: data/tools/GUI.pyw:717
msgid "Diff"
msgstr "השוואה (Diff)"

#. TRANSLATORS: Tooltip explanation for diff run mode.
#: data/tools/GUI.pyw:726
msgid "Show differences in converted files"
msgstr "הצגת הבדלים בקבצים שהומרו"

#: data/tools/GUI.pyw:729
msgid "Revert"
msgstr "שחזור"

#. TRANSLATORS: Tooltip explanation for revert run mode.
#: data/tools/GUI.pyw:738
msgid "Revert conversions using back-up files"
msgstr "שחזור המרות באמצעות קבצי הגיבוי"

