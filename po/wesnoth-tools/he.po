msgid "Terminate script"
msgstr "עצירת הסקריפט"

#: data/tools/GUI.pyw:443
msgid "Cut"
msgstr "גזירה"

#: data/tools/GUI.pyw:448
msgid "Copy"
msgstr "העתקה"

#: data/tools/GUI.pyw:454
msgid "Paste"
msgstr "הדבקה"

#: data/tools/GUI.pyw:460
msgid "Select All"
msgstr "בחירת הכל"

