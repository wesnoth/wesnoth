#: data/tools/GUI.pyw:89
#, python-brace-format
msgid ""
"‘{0}’ directory not found. Please run the GUI.pyw program packaged with the "
"Wesnoth installation."
msgstr ""
"התיקייה '{0}' לא נמצאה. נא להריץ את תוכנית GUI.pyw המצורפת להתקנת ווסנות'."

