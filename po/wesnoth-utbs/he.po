#. [dummy]: id=rain_of_arrows
#: data/campaigns/Under_the_Burning_Suns/utils/abilities.cfg:1641
msgid "rain of arrows"
msgstr "מטר חיצים"

#. [dummy]: id=rain_of_arrows
