#~ msgid "campaign_landing^Welcome to Wesnoth v1.20"
#~ msgstr "ברוכים הבאים לווסנות' גרסה 1.20"

#~ msgid ""
#~ "campaign_landing^<b>If you’re new to Wesnoth</b>, the opening story arc "
#~ "starts with <span color='#e1e119' style='italic'>The South Guard</span> "
#~ "and follows the campaigns in the order that they’re listed on the left, "
#~ "concluding half a century later with <span color='#e1e119' "
#~ "style='italic'>Heir to the Throne</span>. The intended way to learn both "
#~ "the story and the game mechanics is to play the campaigns in that order."
#~ msgstr ""
#~ "<b>אם ווסנות' חדש עבורך</b>, קשת הסיפור הפותחת מתחילה ב<span "
#~ "color='#e1e119' style='italic'>משמר הדרום</span> וממשיכה בקמפיינים לפי "
#~ "הסדר שבו הן מופיעות מימין, ומסתיימת חצי מאה מאוחר יותר ב<span "
#~ "color='#e1e119' style='italic'>יורש הכתר</span>. הדרך המומלצת ללמוד גם את "
#~ "הסיפור וגם את מנגנוני המשחק היא לשחק את הקמפיינים בסדר הזה."

#~ msgid ""
#~ "campaign_landing^<b>If you’re a returning player</b>, you’ll notice a "
#~ "number of changes since v1.18:"
#~ msgstr "<b>אם אתה שחקן ותיק שחוזר</b>, תבחין בכמה שינויים מאז גרסה 1.18:"

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>Heir to the Throne</"
#~ "span> now features an open world with 33 branching scenarios, each "
#~ "awarding Konrad unique recruits, companions, or items. The original "
#~ "campaign is still available as <i>Heir to the Throne, Classic</i>."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>יורש הכתר</span> כוללת כעת עולם פתוח "
#~ "עם 33 תרחישים מסתעפים, שכל אחד מהם מעניק לקונרד יחידות גיוס, בני-לוויה או "
#~ "חפצים ייחודיים. הקמפיין המקורית עדיין זמינה בשם <i>יורש הכתר, קלאסי</i>."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>The Deceiver’s "
#~ "Gambit</span> replaces <i>Delfador’s Memoirs</i>. Follow a young mage "
#~ "from the shores of Alduin to the halls of the King as they war against "
#~ "the fierce orcs of the north. Choose between 23 magic spells as you bear "
#~ "witness to the rise of a tyrant."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>מהלכו של הנוכל</span> מחליפה את "
#~ "<i>זכרונותיו של דלפדור</i>. עקוב אחר קוסם צעיר מחופי אלדואין ועד אולמות "
#~ "המלך, במלחמתו באורקים העזים של הצפון. בחר מבין 23 לחשי קסם בעודך עֵד "
#~ "לעלייתו של רודן."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>Dusk of Dawn</span> "
#~ "is our first troll campaign. Lead the Golden Flame Tribe out from the "
#~ "bowels of Irdya and up to the surface world — but beware what awaits you "
#~ "there."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>דמדומי השחר</span> היא מערכת הטרולים "
#~ "הראשונה שלנו. הובל את שבט הלהבה הזהובה ממעמקי אירדיה אל פני השטח — אך "
#~ "היזהר ממה שמחכה לך שם."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>Of Pearls and "
#~ "Pirates</span> is a new beginner-oriented campaign set in a sleepy "
#~ "fishing town on the Bay of Pearls. When corsairs strike, the villagers "
#~ "must join forces with the local merfolk and take the fight to the pirates."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>על פנינים ופיראטים</span> היא מערכת "
#~ "חדשה המיועדת למתחילים, המתרחשת בעיירת דייגים רדומה במפרץ הפנינים. "
#~ "כשהשודדים תוקפים, על תושבי הכפר לחבור לבני-הים המקומיים ולצאת לקרב מול "
#~ "הפיראטים."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>The South Guard</"
#~ "span> has been significantly revised, and now replaces the classic "
#~ "<i>Battle Training</i> tutorial. For players nostalgic for Delfador's "
#~ "tutelage, the original tutorial is still available as part of <i>Heir to "
#~ "the Throne, Classic</i>."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>משמר הדרום</span> עברה שכתוב מקיף, "
#~ "והיא מחליפה כעת את מדריך ההדרכה הקלאסי <i>אימון קרבי</i>. לשחקנים "
#~ "המתגעגעים להדרכתו של דלפדור, המדריך המקורי עדיין זמין כחלק מ<i>יורש הכתר, "
#~ "קלאסי</i>."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>The Hammer of "
#~ "Thursagan</span> has been enhanced with story adjustments, improved enemy "
#~ "AI, a new Thunderer advancement, a redesign of <i>High Pass</i>, and the "
#~ "re-addition of the formerly removed <i>Mages and Drakes</i>."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>פטישו של תורסגן</span> שופרה בהתאמות "
#~ "סיפוריות, בבינה מלאכותית טובה יותר לאויב, בקידום חדש ליחידת אדון-הרעם, "
#~ "בעיצוב מחדש של <i>המעבר הגבוה</i>, ובהחזרת התרחיש <i>קוסמים ודרקודמים</i> "
#~ "שהוסר בעבר."

#~ msgid ""
#~ "campaign_landing^<span color='#e1e119' style='italic'>Winds of Fate</"
#~ "span> has been rebalanced with much lower recall costs, redesigned "
#~ "wildlife spawners and AI, and a much larger mid-campaign battle. Several "
#~ "characters and dialogue sequences were changed for better continuity with "
#~ "other campaigns."
#~ msgstr ""
#~ "<span color='#e1e119' style='italic'>רוחות הגורל</span> אוזנה מחדש עם "
#~ "עלויות השבה נמוכות בהרבה, מנגנוני הופעת חיות בר ובינה מלאכותית מעוצבים "
#~ "מחדש, וקרב אמצע-קמפיין גדול בהרבה. כמה דמויות ורצפי דיאלוג שונו לשם "
#~ "רציפות טובה יותר עם קמפיינים אחרות."

#~ msgid ""
#~ "campaign_landing^For a full list of changes, consult our official "
#~ "changelog at https://www.wesnoth.org/start/1.20/"
#~ msgstr ""
#~ "לרשימה המלאה של השינויים, עיין ביומן השינויים הרשמי שלנו בכתובת https://"
#~ "www.wesnoth.org/start/1.20/"

